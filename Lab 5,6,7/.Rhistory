group = "Population Density",
popup = ~paste0(
"<b>County:</b> ", NAME, "<br>",
"<b>Population Density:</b> ", round(pop_density, 2))) %>%
# parks
addPolygons(
data = parks_all,
fillColor = ~pal_parks(park_type),
color = "darkgreen",
weight = 1,
fillOpacity = 0.6,
group = "Parks",
popup = ~paste0("<b>Park Type:</b> ", park_type)) %>%
# layer control
addLayersControl(
overlayGroups = c("Population Density", "Parks"),
options = layersControlOptions(collapsed = FALSE)) %>%
# legend for pop
addLegend(
pal = pal_density,
values = sa2$pop_density,
title = "Population Density",
position = "bottomright") %>%
# legend for parks
addLegend(
pal = pal_parks,
values = parks_all$park_type,
title = "Park Type",
position = "bottomleft") %>%
# my one extrathing
addScaleBar()
