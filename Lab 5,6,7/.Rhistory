# your code here
options(tigris_use_cache = TRUE)
# get county population
counties_all <- get_acs(
geography = "county",
variables = "B01003_001",   # total population
year = 2020,
geometry = TRUE)
counties_all <- counties_all %>%
mutate(NAME = gsub(" County,.*", "", NAME))
counties_all <- counties_all %>%
rename(poptotal = estimate)
sw_counties <- c(
"Hamilton", "Clermont", "Butler", "Warren", "Preble", "Montgomery",
"Clinton", "Highland", "Brown", "Adams", "Greene", "Fayette",
"Ross", "Pike", "Scioto", "Pickaway")
sa2 <- counties_all %>%
filter(NAME %in% sw_counties) %>%
st_make_valid()
# project to equal-area CRS FIRST
sa2 <- st_transform(sa2, "ESRI:102010")
# then calculate area + density
sa2 <- sa2 %>%
mutate(
area_km2 = as.numeric(st_area(geometry)) / 1e6,
pop_density = poptotal / area_km2)
# then convert to WGS84 for leaflet
sa2 <- st_transform(sa2, 4326)
parks_all <- read_sf("./static_mapping/oh_parks.gpkg") %>%
st_transform(st_crs(sa2)) %>%
st_filter(sa2) %>%
st_make_valid()
parks_all <- parks_all %>%
mutate(
park_type = case_when(
grepl("Local park", FEATTYPE, ignore.case = TRUE) ~ "Local Park",
grepl("County park", FEATTYPE, ignore.case = TRUE) ~ "County Park",
grepl("State park or Forest", FEATTYPE, ignore.case = TRUE) ~ "State Park / Forest",
TRUE ~ "Other"))
sa2 <- st_transform(sa2, 4326)
parks_all <- st_transform(parks_all, 4326)
# layers I'm using:
#  - [social layer]: ...
#  - [environmental layer]: ...
# your code here
# population density
pal_density <- colorBin(
palette = "Purples",
domain = sa2$pop_density,
bins = 5
)
# park types
pal_parks <- colorFactor(
palette = c("yellow", "green", "darkgreen", "orange"),
levels = unique(parks_all$park_type))
leaflet() %>%
setView(lng = -84.4, lat = 39.2, zoom = 7) %>%
addProviderTiles(providers$CartoDB.Positron) %>%
# population density
addPolygons(
data = sa2,
fillColor = ~pal_density(pop_density),
color = "black",
weight = 1,
fillOpacity = 0.7,
group = "Population Density",
popup = ~paste0(
"<b>County:</b> ", NAME, "<br>",
"<b>Population Density:</b> ", round(pop_density, 2))) %>%
# parks
addPolygons(
data = parks_all,
fillColor = ~pal_parks(park_type),
color = "darkgreen",
weight = 1,
fillOpacity = 0.6,
group = "Parks",
popup = ~paste0("<b>Park Type:</b> ", park_type)) %>%
# layer control
addLayersControl(
overlayGroups = c("Population Density", "Parks"),
options = layersControlOptions(collapsed = FALSE)) %>%
# legend for pop
addLegend(
pal = pal_density,
values = sa2$pop_density,
title = "Population Density",
position = "bottomright") %>%
# legend for parks
addLegend(
pal = pal_parks,
values = parks_all$park_type,
title = "Park Type",
position = "bottomleft") %>%
# my one extrathing
addScaleBar()
