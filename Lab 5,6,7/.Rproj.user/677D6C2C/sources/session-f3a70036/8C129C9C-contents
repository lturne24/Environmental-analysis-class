leaflet(counties_lisa) %>%
  addProviderTiles(providers$CartoDB.Positron, group = "Light") %>%
  addProviderTiles(providers$Esri.WorldImagery, group = "Satellite") %>%
  addProviderTiles(providers$OpenTopoMap, group = "Topo") %>%

  addPolygons(
    fillColor = ~pal_lisa(lisa_cluster),
    color = "black",
    weight = 1,
    fillOpacity = 0.7,
    popup = ~paste0(
      "<b>Cluster:</b> ", lisa_cluster, "<br>",
      "<b>p-value:</b> ", round(p_value, 4)),
    group = "LISA") %>%
addLayersControl(
    baseGroups = c("Light", "Satellite", "Topo"),
    overlayGroups = c("LISA"),
    options = layersControlOptions(collapsed = FALSE)) %>%
addLegend(
    pal = pal_lisa,
    values = ~lisa_cluster,
    title = "LISA Cluster",
    position = "bottomright"
  )
```

*Tip: The `addLayersControl()` function accepts `baseGroups` (radio buttons, one active at a time) and `overlayGroups` (checkboxes, multiple can be active). Basemaps should be `baseGroups`.*

