get_letters <- function(formula, data){
dunn <- dunnTest(formula, data = data, method = "bh")$res
# Fix comparison format
dunn$Comparison <- gsub(" - ", "-", dunn$Comparison)
# Create named vector of p-values
pvals <- dunn$P.adj
names(pvals) <- dunn$Comparison
# Generate letters
letters <- multcompView::multcompLetters(pvals, threshold = 0.05)
# Convert to dataframe
cld <- data.frame(
Group = names(letters$Letters),
Letter = letters$Letters
)
return(cld)
}
cld_CHLA <- get_letters(CHLA_RESULT ~ AG_ECO9, HNLC_data)
cld_PTL  <- get_letters(PTL_RESULT ~ AG_ECO9, HNLC_data)
cld_NTL  <- get_letters(NTL_RESULT ~ AG_ECO9, HNLC_data)
HNLC_data$AG_ECO9 <- factor(HNLC_data$AG_ECO9)
label_pos_CHLA <- HNLC_data %>%
group_by(AG_ECO9) %>%
summarise(y = max(CHLA_RESULT, na.rm = TRUE))
label_pos_PTL <- HNLC_data %>%
group_by(AG_ECO9) %>%
summarise(y = max(PTL_RESULT, na.rm = TRUE))
label_pos_NTL <- HNLC_data %>%
group_by(AG_ECO9) %>%
summarise(y = max(NTL_RESULT, na.rm = TRUE))
# Join letters
plot_labels_CHLA <- left_join(cld_CHLA, label_pos_CHLA, by = c("Group" = "AG_ECO9"))
plot_labels_PTL  <- left_join(cld_PTL,  label_pos_PTL,  by = c("Group" = "AG_ECO9"))
plot_labels_NTL  <- left_join(cld_NTL,  label_pos_NTL,  by = c("Group" = "AG_ECO9"))
ggplot(HNLC_data, aes(x = AG_ECO9, y = CHLA_RESULT, fill = AG_ECO9)) +
geom_boxplot(width = 0.2, outlier.size = 0.5, outlier.alpha = 0.8) +
geom_text(data = plot_labels_CHLA,
aes(x = Group, y = y, label = Letter),
inherit.aes = FALSE,
vjust = -0.5, size = 4) +
scale_fill_brewer(palette = "Pastel1") +
theme_minimal() +
theme(legend.position = "none")
ggplot(HNLC_data, aes(x = AG_ECO9, y = PTL_RESULT, fill = AG_ECO9)) +
geom_boxplot(width = 0.2, outlier.size = 0.5, outlier.alpha = 0.8) +
geom_text(data = plot_labels_PTL,
aes(x = Group, y = y, label = Letter),
inherit.aes = FALSE,
vjust = -0.5, size = 4) +
scale_fill_brewer(palette = "Pastel1") +
theme_minimal() +
theme(legend.position = "none")
ggplot(HNLC_data, aes(x = AG_ECO9, y = NTL_RESULT, fill = AG_ECO9)) +
geom_boxplot(width = 0.2, outlier.size = 0.5, outlier.alpha = 0.8) +
geom_text(data = plot_labels_NTL,
aes(x = Group, y = y, label = Letter),
inherit.aes = FALSE,
vjust = -0.5, size = 4) +
scale_fill_brewer(palette = "Pastel1") +
theme_minimal() +
theme(legend.position = "none")
#filter out low metals (lit based----
Iron_low <- Iron_2018_2019 %>%
filter(DetectionQuantitationLimitMeasure.MeasureValue.Clean.UGL < 10)
Manganese_low <- Manganese_2018_2019 %>%
filter(DetectionQuantitationLimitMeasure.MeasureValue.Clean.UGL < 1)
Nickel_low <- Nickel_2018_2019 %>%
filter(DetectionQuantitationLimitMeasure.MeasureValue.Clean.UGL < 1.4)
Zinc_low <- Zinc_2018_2019 %>%
filter(DetectionQuantitationLimitMeasure.MeasureValue.Clean.UGL < 5)
#combine low metals into one set ----
Iron_low$Metal <- "Iron"
Manganese_low$Metal <- "Manganese"
Nickel_low$Metal <- "Nickel"
Zinc_low$Metal <- "Zinc"
Iron_low$HUCEightDigitCode <- as.character(Iron_low$HUCEightDigitCode)
Manganese_low$HUCEightDigitCode <- as.character(Manganese_low$HUCEightDigitCode)
Nickel_low$HUCEightDigitCode <- as.character(Nickel_low$HUCEightDigitCode)
Zinc_low$HUCEightDigitCode <- as.character(Zinc_low$HUCEightDigitCode)
metals_low <- dplyr::bind_rows(
Iron_low, Manganese_low,
Nickel_low, Zinc_low)
ggplot() +
geom_polygon(data = us_states,
aes(x = long, y = lat, group = group),
fill = "gray95",
color = "black",
linewidth = 0.2) +
geom_point(data = metals_low,
aes(x = lon.Clean, y = lat.Clean, color = Metal),
size = .5,
alpha = 0.7) +
coord_fixed(1.3) +
theme_minimal() +
labs(color = "Metal",
title = paste0("Sites with Metal Limitation")) +
theme(legend.position = "bottom")
metals_low_summary <- metals_low %>%
group_by(MonitoringLocationIdentifier, lat.Clean, lon.Clean) %>%
summarise(
metals_present = paste(sort(unique(Metal)), collapse = ", "),
n_metals = n_distinct(Metal),
.groups = "drop"
)
ggplot() +
geom_polygon(data = us_states,
aes(x = long, y = lat, group = group),
fill = "gray95",
color = "black",
linewidth = 0.2) +
geom_point(data = metals_low_summary,
aes(x = lon.Clean, y = lat.Clean, color = metals_present),
size = 1,
alpha = 0.8) +
coord_fixed(1.3) +
theme_minimal() +
labs(color = "Metal Limitation Combination",
title = "Sites with Overlapping Metal Limitation") +
theme(legend.position = "right")
