geom_point(data = byECO9_HNLChlorophyll_sites,
aes(x = LON_DD83,
y = LAT_DD83,
color = EcoRegion,
shape = nutrient_group),
size = 1.5) +
coord_fixed(1.3) +
theme_minimal() +
ggtitle("HNLC Chlorophyll Sites Across EPA Eco 9 Regions") +
theme(legend.position = "right")
