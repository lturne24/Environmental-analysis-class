eco9_data = eco9_info
)
}
# example
site_lookup_full("1119USBR_WQX-DVO112")
site_lookup_full_COMID <- function(site_id) {
# get overlap info (finding SITE_ID)
overlap_info <- overlap_huc8 %>%
filter(MonitoringLocationIdentifier == site_id)
#extract SITE_ID
site_ids <- overlap_info %>%
pull(SITE_ID) %>%
unique()
# pull full data
eco9_info <- HNLC_data %>%
filter(SITE_ID %in% site_ids)
# Step 4: return everything
list(
overlap_data = overlap_info,
Site_data = eco9_info
)
}
#run function
site_lookup_full_COMID("USGS-01113895")
site_lookup_full <- function(site_id) {
# get overlap info (finding SITE_ID)
overlap_info <- overlap_huc8 %>%
filter(MonitoringLocationIdentifier == site_id)
# extract SITE_ID
site_ids <- overlap_info %>%
pull(SITE_ID) %>%
unique()
# pull full data
eco9_info <- HNLC_data %>%
filter(SITE_ID %in% site_ids)
# put it in
list(
overlap_data = overlap_info,
Site_data = eco9_info
)
}
# example
site_lookup_full("1119USBR_WQX-DVO112")
byECO9_HNLChlorophyll_sites <- byECO9_HNLChlorophyll_sites %>%
left_join(
HNLC_data %>% select(SITE_ID, COMID, HUC8),
by = "SITE_ID")
byECO9_HNLChlorophyll_sites <- byECO9_HNLChlorophyll_sites %>%
mutate(HUC8_clean = sub("^H", "", HUC8))
