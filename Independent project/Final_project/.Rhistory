site_lookup <- function(site_id) {
metal_info <- metals_low %>%
filter(MonitoringLocationIdentifier == site_id)
nutrient_info <- byECO9_HNLChlorophyll_sites %>%
filter(MonitoringLocationIdentifier == site_id)
list(
metals = metal_info,
nutrients = nutrient_info
)
}
# example
site_lookup("AZDEQ_SW-1971")
site_lookup <- function(site_id) {
overlap_huc8 %>%
filter(MonitoringLocationIdentifier == site_id)
}
# example
site_lookup("AZDEQ_SW-1971")
# example
site_lookup("1119USBR_WQX-DVO112")
site_lookup_full <- function(site_id) {
# Step 1: get overlap info (this contains SITE_ID)
overlap_info <- overlap_huc8 %>%
filter(MonitoringLocationIdentifier == site_id)
# Step 2: extract SITE_ID(s)
site_ids <- overlap_info %>%
pull(SITE_ID) %>%
unique()
# Step 3: pull full nutrient/ecoregion data
eco9_info <- byECO9_HNLChlorophyll_sites %>%
filter(SITE_ID %in% site_ids)
# Step 4: return everything
list(
overlap_data = overlap_info,
eco9_data = eco9_info
)
}
# example
site_lookup_full("1119USBR_WQX-DVO112")
# Step 3: pull full nutrient/ecoregion data
eco9_info <- HNLC_data %>%
filter(SITE_ID %in% site_ids)
site_lookup_full <- function(site_id) {
# Step 1: get overlap info (this contains SITE_ID)
overlap_info <- overlap_huc8 %>%
filter(MonitoringLocationIdentifier == site_id)
# Step 2: extract SITE_ID(s)
site_ids <- overlap_info %>%
pull(SITE_ID) %>%
unique()
# Step 3: pull full nutrient/ecoregion data
eco9_info <- HNLC_data %>%
filter(SITE_ID %in% site_ids)
# Step 4: return everything
list(
